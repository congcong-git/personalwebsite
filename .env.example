# 站点地址（用于 OG/canonical/sitemap，可留空回退 http://localhost:3000）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# CloudBase 内容后台（不填则回退本地 content/）
CLOUDBASE_ENV_ID=your-env-id
CLOUDBASE_SECRET_ID=your-secret-id
CLOUDBASE_SECRET_KEY=your-secret-key

# 调试后台
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=
ADMIN_ALLOW_PRODUCTION=false

# Giscus 评论（在 GitHub 仓库开启 Discussions + https://giscus.app 生成）
NEXT_PUBLIC_GISCUS_REPO=your-github-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=your-repo-id
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your-category-id
NEXT_PUBLIC_GISCUS_LANG=zh-CN

# 51.la 统计（注册 https://www.51.la 后获取，配置后自动启用）
NEXT_PUBLIC_51LA_ID=your-site-id
NEXT_PUBLIC_51LA_CK=your-ck
