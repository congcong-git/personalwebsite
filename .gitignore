# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 但保留模板文件，供 README 的「复制 .env.example」使用
!.env.example

# 后台上传的文件（简历 / 二维码 / 图片等）：需随仓库提交以纳入静态构建产物部署
# 注意：被忽略的文件不会出现在线上构建产物中，故上传目录不再忽略
!/public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.codebuddy
